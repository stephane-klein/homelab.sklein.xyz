# DEPRECATED: this monolithic helmfile is being refactored into one
# self-contained directory per application under apps/<app>/ (see
# docs/decisions/2026-08_001-per-app-helmfile-directories.md, ADR 001).
# Do not add new releases here; create apps/<app>/ instead.
repositories:
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: sintef-mosquitto
    url: https://sintef.github.io/mosquitto-helm-chart
  - name: zigbee2mqtt
    url: https://charts.zigbee2mqtt.io
  - name: grafana
    url: https://grafana.github.io/helm-charts

releases:
  - name: mosquitto
    namespace: zigbee
    createNamespace: true
    chart: sintef-mosquitto/mosquitto
    version: 0.1.1
    values:
      - values/mosquitto.yaml

  - name: zigbee2mqtt
    namespace: zigbee
    createNamespace: true
    chart: zigbee2mqtt/zigbee2mqtt
    version: 2.12.0
    values:
      - values/zigbee2mqtt.yaml

  - name: hindsight-cnpg
    namespace: hindsight
    createNamespace: true
    chart: cnpg/cluster
    version: 0.7.0
    values:
      - values/cnpg-hindsight.yaml

  - name: hindsight
    namespace: hindsight
    createNamespace: false
    chart: oci://ghcr.io/vectorize-io/charts/hindsight
    version: 0.8.3
    values:
      - values/hindsight.yaml

  - name: grafana
    namespace: grafana
    createNamespace: true
    chart: grafana/grafana
    version: 10.5.15
    values:
      - values/grafana.yaml
