# Declarative definition of the Forgejo Actions runner LXC instance hosted on
# incus-server1.homelab.stephane-klein.info (remote `incus1`).
#
# This file is a minijinja template rendered by scripts/render.sh (which injects
# the NetBird setup key and the homelab CA certificate). Do not commit the
# rendered instance.yaml — it embeds secrets.
#
# Lifecycle:
#   mise run //apps/forgejo/runner:render    # gopass secrets -> instance.yaml
#   mise run //apps/forgejo/runner:apply     # incus-apply incus1: instance.yaml
#   mise run //apps/forgejo/runner:ssh       # shell in the instance
#
# The base image `forgejo-runner` is a LXC variant of the custom Fedora 44 image
# built by scripts/build-image.sh (podman + netbird + cloud-init). It is copied
# onto incus1 from the `sklein` simplestreams remote by scripts/ensure-image.sh.
kind: instance
name: forgejo-runner1
image: forgejo-runner
profiles:
  - default
config:
  # Do not let CI builds starve the other workloads of incus-server1.
  limits.cpu: "4"
  limits.memory: 6GiB
  security.nesting: "true"
  cloud-init.user-data: |
    #cloud-config
    hostname: forgejo-runner1
    fqdn: forgejo-runner1.homelab.stephane-klein.info
    prefer_fqdn_over_hostname: true
    create_hostname_file: true
    package_update: true
    packages:
      - git
    users:
      - name: fedora
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          - ssh-rsa  contact@stephane-klein.info
    write_files:
      - path: /tmp/netbird-setup-key
        content: {{ ENV.NETBIRD_SETUP_KEY }}
        permissions: "0600"
      - path: /etc/pki/ca-trust/source/anchors/homelab-ca.crt
        content: {{ ENV.HOMELAB_CA_B64 }}
        encoding: b64
        permissions: "0644"
    runcmd:
      - [bash, /usr/local/sbin/enroll-netbird.sh, /tmp/netbird-setup-key]
      - [update-ca-trust]
