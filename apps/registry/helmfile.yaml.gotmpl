repositories:
  - name: twuni
    url: https://twuni.github.io/docker-registry.helm

releases:
  - name: docker-registry
    namespace: registry
    createNamespace: true
    chart: twuni/docker-registry
    version: 3.0.0
    values:
      - values.yaml
    set:
      # htpasswd file content (bcrypt lines, one per user) assembled from Gopass
      # by scripts/deploy.sh — never committed.
      - name: secrets.htpasswd
        value: '{{ requiredEnv "REGISTRY_HTPASSWD" }}'
