{
  "title": "Pod Overview",
  "uid": "pod-overview",
  "tags": ["pod", "kubernetes"],
  "schemaVersion": 39,
  "version": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "nodename",
        "label": "Node",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(container_cpu_usage_seconds_total, instance)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(container_cpu_usage_seconds_total, namespace)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "CPU Usage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU by container (cores)",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["last", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{instance=~\"$nodename\", namespace=~\"$namespace\", container!=\"\"}[5m])) by (pod, namespace, instance)",
          "legendFormat": "{{namespace}}/{{pod}} ({{instance}})",
          "datasource": "Prometheus"
        }
      ],
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Memory Usage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Working set memory by container (bytes)",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["last", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{instance=~\"$nodename\", namespace=~\"$namespace\", container!=\"\"}) by (pod, namespace, instance)",
          "legendFormat": "{{namespace}}/{{pod}} ({{instance}})",
          "datasource": "Prometheus"
        }
      ],
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 }
    }
  ]
}
